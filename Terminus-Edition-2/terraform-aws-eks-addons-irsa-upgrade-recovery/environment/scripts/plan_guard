#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

PROTECTED = {
    "module.eks.aws_eks_cluster.this[0]",
    "module.eks.aws_security_group.cluster[0]",
    'module.eks.aws_eks_node_group.this["system"]',
    'module.eks.aws_eks_node_group.this["apps"]',
    'module.eks.aws_eks_node_group.this["batch"]',
}

REQUIRED_OUTPUTS = {
    "cluster_endpoint",
    "cluster_security_group_id",
    "oidc_provider_arn",
    "private_subnet_ids",
    "managed_node_group_names",
    "addon_irsa_role_arns",
}

ALLOWED_ACTIONS = {"no-op", "read", "update"}


def fail(code, payload):
    print(json.dumps(payload, separators=(",", ":")), file=sys.stderr)
    raise SystemExit(code)


def app_root():
    if os.environ.get("APP_ROOT"):
        return Path(os.environ["APP_ROOT"])
    return Path(__file__).resolve().parents[1]


def main():
    try:
        plan = json.loads((app_root() / "fixtures" / "plan.json").read_text())
    except Exception as exc:
        fail(1, {"ok": False, "error": str(exc)})

    seen = set()
    violations = []
    admin_creates = []

    for change in plan.get("resource_changes", []):
        address = change.get("address", "")
        actions = change.get("change", {}).get("actions", [])
        if "node_addon_admin" in address and "create" in actions:
            admin_creates.append(change)
        if address not in PROTECTED:
            continue
        seen.add(address)
        if not actions or any(action not in ALLOWED_ACTIONS for action in actions):
            violations.append(change)

    missing_protected = sorted(PROTECTED - seen)
    if violations or admin_creates or missing_protected:
        fail(
            2,
            {
                "ok": False,
                "violations": violations,
                "admin_creates": admin_creates,
                "missing_protected": missing_protected,
            },
        )

    outputs = plan.get("configuration", {}).get("root_module", {}).get("outputs", {})
    missing_outputs = sorted(REQUIRED_OUTPUTS - set(outputs))
    if missing_outputs:
        fail(3, {"ok": False, "missing_outputs": missing_outputs})

    print('{"ok":true}')


if __name__ == "__main__":
    main()
