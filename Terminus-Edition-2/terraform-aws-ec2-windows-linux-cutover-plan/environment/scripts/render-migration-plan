#!/usr/bin/env bash
set -euo pipefail

TF_ROOT="/app/environment/terraform"
OUT_DIR="/app/output"
PLAN_FILE="${OUT_DIR}/ec2_linux_migration.tfplan"
PLAN_JSON="${OUT_DIR}/ec2_linux_migration_plan.json"

mkdir -p "${OUT_DIR}" "${OUT_DIR}/run_logs"
cd "${TF_ROOT}"

export TF_CLI_CONFIG_FILE="${TF_CLI_CONFIG_FILE:-/opt/terraform.tfrc}"
export TF_IN_AUTOMATION="true"
export AWS_EC2_METADATA_DISABLED="true"
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-offline}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-offline}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"

terraform init -backend=false -input=false > "${OUT_DIR}/run_logs/terraform_init.log"
terraform validate > "${OUT_DIR}/run_logs/terraform_validate.log"
terraform plan -refresh=false -input=false -out="${PLAN_FILE}" > "${OUT_DIR}/run_logs/terraform_plan.log"
terraform show -json "${PLAN_FILE}" > "${PLAN_JSON}"

echo "${PLAN_JSON}"
