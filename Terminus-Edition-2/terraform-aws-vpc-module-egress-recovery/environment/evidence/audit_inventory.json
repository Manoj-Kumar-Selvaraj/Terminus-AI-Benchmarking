{
  "flow_log": {
    "id": "fl-prod-vpc-existing",
    "scope": "route-table",
    "traffic_type": "REJECT",
    "destination": "cloud-watch-logs",
    "log_group_arn": "arn:aws:logs:us-east-1:111122223333:log-group:/aws/vpc/prod-flow",
    "iam_policy": {
      "Action": [
        "logs:*"
      ],
      "Resource": "*"
    },
    "subnet_ids": [
      "subnet-prod-app-a"
    ],
    "metadata": {
      "audit_ticket": "AUD-9931",
      "retention": "365d"
    }
  },
  "resolver_security_group": {
    "id": "sg-prod-resolver",
    "ingress": [
      {
        "protocol": "tcp",
        "from_port": 53,
        "to_port": 53,
        "cidr_blocks": [
          "0.0.0.0/0"
        ],
        "owner": "terraform-aws-vpc-module"
      },
      {
        "protocol": "udp",
        "from_port": 53,
        "to_port": 53,
        "cidr_blocks": [
          "172.16.20.10/32"
        ],
        "owner": "terraform-aws-vpc-module"
      },
      {
        "protocol": "tcp",
        "from_port": 853,
        "to_port": 853,
        "cidr_blocks": [
          "10.0.0.0/8"
        ],
        "owner": "manual",
        "note": "DoT pilot should be reported only"
      }
    ],
    "metadata": {
      "security_review": "SEC-7781"
    }
  }
}
